{
  "name": "xlang",
  "displayName": "XLang",
  "description": "Syntax highlighting and language configuration for XLang files.",
  "version": "0.1.0",
  "publisher": "xlang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xlang",
        "aliases": [
          "XLang",
          "xlang"
        ],
        "extensions": [
          ".xl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xlang",
        "scopeName": "source.xlang",
        "path": "./syntaxes/xlang.tmLanguage.json"
      }
    ]
  }
}
