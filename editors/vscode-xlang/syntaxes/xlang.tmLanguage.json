{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XLang",
  "scopeName": "source.xlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xlang",
          "match": "//.*$"
        },
        {
          "name": "comment.block.xlang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.xlang",
              "match": "\\\\[tnr\"\\\\0]"
            }
          ]
        },
        {
          "name": "string.quoted.single.xlang",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.xlang",
              "match": "\\\\[tnr'\\\\0]"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.xlang",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(func)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.xlang" },
            "3": { "name": "entity.name.function.xlang" }
          }
        },
        {
          "match": "\\b(struct|enum)(\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.xlang" },
            "3": { "name": "entity.name.type.xlang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xlang",
          "match": "\\b(?:if|elif|else|loop|match|break|continue|return)\\b"
        },
        {
          "name": "storage.modifier.xlang",
          "match": "\\b(?:var|const)\\b"
        },
        {
          "name": "keyword.operator.logical.xlang",
          "match": "\\bnot\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.xlang",
          "match": "\\b(?:i(?:8|16|32|64)|u(?:8|16|32|64)|f32|bool|char|string)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.xlang",
          "match": "\\b(?:0|[1-9][0-9]*)\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.xlang",
          "match": "\\b(?:0|[1-9][0-9]*)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.xlang",
          "match": "(?:==|!=|>=|<=|=>|[+\\-*/%=<>])"
        },
        {
          "name": "punctuation.separator.xlang",
          "match": "[,:;.]"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.xlang",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
        }
      ]
    }
  }
}
